data/*
# The real-world test set's labels, metadata and attribution are tracked; the
# photos themselves are third-party Commons uploads and are re-fetched by
# scripts/fetch_real_world.py from the URLs recorded in metadata.csv.
!data/real_world/
data/real_world/images/
reports/*.html
reports/*.png
*.pyc
__pycache__/
.venv/
*.egg-info/
.DS_Store
models/
SUBMISSION_EMAIL.md

# Deployment bundle: regenerable with scripts/package_deploy.py, ~28 MB of
# thumbnails. (`data/*` above is anchored to the repo root, so this rule is what
# keeps deploy/bundle/data out.)
deploy/bundle/
